{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler", // ✅ ← change this
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    }
    

  },
  "include": [
    "src",
    "src/assets/scss/js/setting.min.js",
    "src/assets/scss/js/utility.min.js"
  ],
  "exclude": ["node_modules"]
}
